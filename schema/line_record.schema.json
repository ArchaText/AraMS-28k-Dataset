{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/TODO/AraMS-28k/schema/line_record.schema.json",
  "title": "AraMS-28k Line Record",
  "description": "Schema for a single line annotation in the AraMS-28k historical Arabic manuscript dataset.",
  "type": "object",
  "required": [
    "line_uid",
    "book_id",
    "page_id",
    "page_image",
    "line_idx",
    "line_type",
    "split",
    "text",
    "geometry",
    "margin_anchor",
    "review"
  ],
  "properties": {
    "line_uid": {
      "type": "string",
      "description": "Globally unique line identifier, e.g. book_03_page_076_L0000"
    },
    "book_id": {
      "type": "string",
      "description": "Book identifier, e.g. book_03",
      "pattern": "^book_[0-9]+$"
    },
    "page_id": {
      "type": "string",
      "description": "Page identifier, e.g. book_03_page_076",
      "pattern": "^book_[0-9]+_page_[0-9]+$"
    },
    "page_image": {
      "type": "string",
      "description": "Relative path to the full page image"
    },
    "line_idx": {
      "type": "integer",
      "description": "Zero-based line index on the page, top-to-bottom reading order",
      "minimum": 0
    },
    "line_type": {
      "type": "string",
      "description": "Layout classification of the line",
      "enum": [
        "main",
        "margin"
      ]
    },
    "split": {
      "type": "string",
      "description": "Dataset split assignment",
      "enum": [
        "train",
        "val",
        "test"
      ]
    },
    "text": {
      "type": "object",
      "description": "Transcriptions and alignment confidence",
      "required": [
        "gt_raw",
        "gemini_raw",
        "confidence"
      ],
      "properties": {
        "gt_raw": {
          "type": "string",
          "description": "Clean reference transcription, typically from a scholarly edition (may include diacritics)"
        },
        "gemini_raw": {
          "type": "string",
          "description": "Raw MLLM OCR hypothesis before any correction"
        },
        "confidence": {
          "type": "number",
          "description": "Fuzzy alignment confidence score in [0, 100]. A value of 100 guarantees character-for-character normalised-string identity (Confidence-100 rule).",
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "geometry": {
      "type": "object",
      "description": "Spatial geometry of the line",
      "required": [
        "baseline",
        "boundary_polygon",
        "bounding_box"
      ],
      "properties": {
        "baseline": {
          "oneOf": [
            {
              "type": "array",
              "description": "Ordered polyline points tracing the text baseline",
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "minItems": 2
            },
            {
              "type": "null",
              "description": "Baseline not available"
            }
          ]
        },
        "boundary_polygon": {
          "oneOf": [
            {
              "type": "array",
              "description": "Ordered polygon vertices faithfully following the text line contour",
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "minItems": 3
            },
            {
              "type": "null",
              "description": "Boundary polygon not available"
            }
          ]
        },
        "bounding_box": {
          "oneOf": [
            {
              "type": "object",
              "description": "Axis-aligned bounding box",
              "required": [
                "x",
                "y",
                "w",
                "h"
              ],
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": 0
                },
                "y": {
                  "type": "number",
                  "minimum": 0
                },
                "w": {
                  "type": "number",
                  "minimum": 0
                },
                "h": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null",
              "description": "Bounding box not available"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "margin_anchor": {
      "oneOf": [
        {
          "type": "object",
          "description": "Anchor linking a margin line to its insertion point in the main text",
          "required": [
            "before",
            "after",
            "line",
            "rotation"
          ],
          "properties": {
            "before": {
              "type": "string",
              "description": "Text of the main line immediately before the insertion point"
            },
            "after": {
              "type": "string",
              "description": "Text of the main line immediately after the insertion point"
            },
            "line": {
              "type": "integer",
              "description": "Index of the main line after which this margin line logically inserts",
              "minimum": 0
            },
            "rotation": {
              "oneOf": [
                {
                  "type": "string",
                  "description": "Coarse orientation of the margin text"
                },
                {
                  "type": "null",
                  "description": "Rotation not assigned"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null",
          "description": "Not a margin line (main lines have null margin_anchor)"
        }
      ]
    },
    "review": {
      "type": "object",
      "description": "Human review flags",
      "required": [
        "edited",
        "validated",
        "deleted",
        "page_reviewed"
      ],
      "properties": {
        "edited": {
          "type": "boolean",
          "description": "Whether the transcription was manually edited during review"
        },
        "validated": {
          "type": "boolean",
          "description": "Whether the line has passed human validation"
        },
        "deleted": {
          "type": "boolean",
          "description": "Whether the line was marked for deletion"
        },
        "page_reviewed": {
          "type": "boolean",
          "description": "Whether the entire containing page was reviewed"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
